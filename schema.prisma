generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  name            String   @default("شركة دفاتر المحاسب")
  nameEn          String?
  taxNumber       String?
  commercialReg   String?
  address         String?
  city            String?
  phone           String?
  email           String?
  website         String?
  logo            String?
  currency        String   @default("EGP")
  fiscalYearStart Int      @default(1)
  vatRate         Float    @default(14)
  whtRate         Float    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  name               String
  email              String?
  phone              String?
  role               String   @default("accountant")
  accessAllCompanies Boolean  @default(true)
  isActive           Boolean  @default(true)
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  portalLoginLogs    PortalLoginLog[]
  assignedTasks      OfficeTask[] @relation("TaskAssignee")
}

model ClientCompany {
  id                  String   @id @default(cuid())
  code                String   @unique
  nameAr              String
  nameEn              String?
  legalForm           String   @default("INDIVIDUAL")
  entityType          String   @default("COMPANY")
  activity            String?
  taxNumber           String?
  taxFileNumber       String?
  taxOffice           String?
  vatRegistrationNumber String?
  vatRegistrationDate   DateTime?
  vatOffice           String?
  commercialRegNumber String?
  socialInsuranceNumber String?
  electronicInvoiceId String?
  electronicInvoiceKey String?
  eSignatureSerial    String?
  eSignatureExpiryDate DateTime?
  phone               String?
  email               String?
  address             String?
  city                String?
  ownerName           String?
  ownerNationalId     String?
  ownerPhone          String?
  contactPerson       String?
  contactPhone        String?
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  obligations         TaxObligation[]
  tasks               OfficeTask[]
  documents           ArchivedDocument[]
  platformCredentials PlatformCredential[]
  portalLoginLogs     PortalLoginLog[]
  invoices            Invoice[]
  purchases           Purchase[]
}

model TaxObligation {
  id            String   @id @default(cuid())
  companyId     String
  company       ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String
  title         String
  period        String
  periodYear    Int
  periodMonth   Int?
  periodQuarter Int?
  dueDate       DateTime
  amountDue     Float?
  amountPaid    Float?
  status        String   @default("PENDING")
  referenceNumber String?
  notes         String?
  fulfilledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasks         OfficeTask[]
}

model OfficeTask {
  id            String   @id @default(cuid())
  taskNumber    String   @unique
  title         String
  description   String?
  companyId     String?
  company       ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  obligationId  String?
  obligation    TaxObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  assignedTo    String?
  assignedToUser User?   @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  priority      String   @default("MEDIUM")
  status        String   @default("TODO")
  category      String   @default("GENERAL")
  dueDate       DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ArchivedDocument {
  id          String   @id @default(cuid())
  companyId   String
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String   @default("OTHER")
  title       String
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  issuedAt    DateTime?
  expiresAt   DateTime?
  tags        String?
  notes       String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformCredential {
  id          String   @id @default(cuid())
  companyId   String
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform    String
  label       String
  loginUrl    String
  username    String?
  password    String?
  extraField  String?
  notes       String?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  lastLoginStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loginLogs   PortalLoginLog[]

  @@unique([companyId, platform])
}

model PortalLoginLog {
  id           String   @id @default(cuid())
  credentialId String
  credential   PlatformCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  companyId    String
  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String
  httpStatus   Int?
  message      String
  durationMs   Int
  createdAt    DateTime @default(now())
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  parentId  String?
  parent    Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children  Account[] @relation("AccountTree")
  isGroup   Boolean  @default(false)
  level     Int      @default(1)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines        JournalLine[]
  safes               Safe[]
  fixedAssets         FixedAsset[]
  depreciationAssets  FixedAsset[] @relation("AssetDepreciationAccount")
  budgetLines         BudgetLine[]
}

model Invoice {
  id            String   @id @default(cuid())
  companyId     String?
  company       ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoiceNumber String   @unique
  date          DateTime
  totalAmount   Float
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ===== حقول الشق المالي (مضافة) =====
  customerId    String?
  customer      Party?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  subtotal      Float      @default(0)
  discount      Float      @default(0)
  taxRate       Float      @default(0)
  taxAmount     Float      @default(0)
  paidAmount    Float      @default(0)
  costAmount    Float      @default(0)
  notes         String?
  createdBy     String     @default("system")
  journalPosted Boolean    @default(false)

  items InvoiceItem[]

  @@index([status])
  @@index([date])
  @@index([customerId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  lineNet     Float    @default(0)
  lineTax     Float    @default(0)
  lineTotal   Float    @default(0)
  costPrice   Float    @default(0)
  accountId   String? // حساب الإيراد المخصص لهذا السطر
  sortOrder   Int      @default(0)

  @@index([invoiceId])
  @@index([productId])
}

model Purchase {
  id             String   @id @default(cuid())
  companyId      String?
  company        ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  purchaseNumber String   @unique
  date           DateTime
  totalAmount    Float
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ===== حقول الشق المالي (مضافة) =====
  supplierId   String?
  supplier     Party?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  subtotal     Float      @default(0)
  discount     Float      @default(0)
  taxRate      Float      @default(0)
  taxAmount    Float      @default(0)
  paidAmount   Float      @default(0)
  notes        String?
  createdBy    String     @default("system")
  journalPosted Boolean   @default(false)

  items PurchaseItem[]

  @@index([status])
  @@index([date])
  @@index([supplierId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  lineNet     Float    @default(0)
  lineTax     Float    @default(0)
  lineTotal   Float    @default(0)
  accountId   String? // حساب المصروف المخصص لهذا السطر
  sortOrder   Int      @default(0)

  @@index([purchaseId])
  @@index([productId])
}

model DocumentSequence {
  id         String   @id @default(cuid())
  type       String   @unique
  prefix     String
  nextNumber Int      @default(1)
  padding    Int      @default(5)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  username  String   @default("system")
  createdAt DateTime @default(now())
}

// ============================================================================
// الشق المالي والمحاسبي — نماذج مضافة
// كل ما سبق أعلاه هو أساس شق المكتب ويبقى كما هو بدون أي تعديل على الحقول.
// ============================================================================

// ===== أطراف الحساب: عملاء وموردون =====

model Party {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  type           String   @default("CUSTOMER") // CUSTOMER | SUPPLIER
  legalName      String?
  taxNumber      String?
  commercialReg  String?
  phone          String?
  email          String?
  address        String?
  city           String?
  openingBalance Float    @default(0)
  balanceSide    String   @default("DEBIT") // nature مدين أو دائن للرصيد الافتتاحي
  creditLimit    Float?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices  Invoice[]
  purchases Purchase[]
  payments  Payment[]

  @@index([type, isActive])
  @@index([name])
}

model Safe {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  type           String   @default("CASH") // CASH خزينة | BANK حساب بنكي
  accountId      String? // الحساب المقابل في دليل الحسابات
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  openingBalance Float    @default(0)
  bankName       String?
  accountNumber  String?
  iban           String?
  branch         String?
  currency       String   @default("EGP")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]

  @@index([type, isActive])
}

model Payment {
  id        String   @id @default(cuid())
  number    String   @unique
  type      String // IN تحصيل | OUT صرف
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  safeId    String?
  safe      Safe?    @relation(fields: [safeId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  amount    Float
  method    String   @default("CASH") // CASH | BANK | CHEQUE | TRANSFER
  reference String?
  sourceType String? // INVOICE | PURCHASE | OTHER
  sourceId   String?
  notes      String?
  createdBy  String   @default("system")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, date])
  @@index([partyId])
  @@index([sourceType, sourceId])
}

// ===== القيود اليومية ودليل الحسابات =====

model JournalEntry {
  id          String    @id @default(cuid())
  number      String    @unique
  date        DateTime
  description String
  sourceType  String? // INVOICE | PURCHASE | PAYMENT | ASSET_DEPRECIATION | OPENING | MANUAL
  sourceId    String?
  companyId   String?
  status      String    @default("POSTED") // DRAFT | POSTED | REVERSED
  totalDebit  Float     @default(0)
  totalCredit Float     @default(0)
  postedAt    DateTime?
  reversedById String?
  notes       String?
  createdBy   String    @default("system")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines JournalLine[]

  @@index([date])
  @@index([status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  partyId        String?
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  costCenter     String?
  sortOrder      Int          @default(0)

  @@index([accountId])
  @@index([journalEntryId])
}

// ===== المخزون =====

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String?
  unit        String   @default("قطعة")
  quantity    Float    @default(0)
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  minStock    Float    @default(0)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  movements      StockMovement[]

  @@index([name])
  @@index([isActive])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // IN مشتريات | OUT مبيعات | ADJUST تسوية | OPENING رصيد افتتاحي
  quantity  Float
  unitCost  Float    @default(0)
  date      DateTime @default(now())
  safeId    String?
  sourceType String?
  sourceId   String?
  notes     String?
  createdBy String   @default("system")
  createdAt DateTime @default(now())

  @@index([productId, date])
  @@index([type])
}

// ===== الأصول الثابتة والإهلاك =====

model FixedAsset {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  category      String?
  acquisitionDate DateTime
  cost          Float
  salvageValue  Float    @default(0)
  lifeYears     Float    @default(5)
  method        String   @default("STRAIGHT_LINE") // STRAIGHT_LINE | DECLINING
  salvageRate   Float    @default(0)
  accumulatedDepreciation Float @default(0)
  accountId     String? // حساب الأصل في دليل الحسابات
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  depreciationAccountId String? // حساب مصروف الإهلاك
  depreciationAccount Account? @relation("AssetDepreciationAccount", fields: [depreciationAccountId], references: [id], onDelete: SetNull)
  status        String   @default("ACTIVE") // ACTIVE | DISPOSED
  disposalDate  DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  depreciations DepreciationEntry[]

  @@index([status])
}

model DepreciationEntry {
  id         String     @id @default(cuid())
  assetId    String
  asset      FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodYear Int
  periodMonth Int?
  amount     Float
  accumAfter Float      @default(0)
  date       DateTime
  journalEntryId String?
  notes      String?
  createdAt  DateTime   @default(now())

  @@unique([assetId, periodYear, periodMonth])
  @@index([periodYear])
}

// ===== الموظفون والرواتب =====

model Employee {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  jobTitle        String?
  department      String?
  nationalId      String?
  phone           String?
  email           String?
  hireDate        DateTime @default(now())
  basicSalary     Float    @default(0)
  housingAllowance Float   @default(0)
  transportAllowance Float @default(0)
  otherAllowance   Float    @default(0)
  insuranceNumber String?
  bankName        String?
  bankAccount     String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payslips Payslip[]

  @@index([isActive])
}

model PayrollRun {
  id          String   @id @default(cuid())
  periodYear  Int
  periodMonth Int
  status      String   @default("DRAFT") // DRAFT | APPROVED | POSTED
  totalGross  Float    @default(0)
  totalDeductions Float @default(0)
  totalNet    Float    @default(0)
  journalEntryId String?
  notes       String?
  createdBy   String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  @@unique([periodYear, periodMonth])
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic        Float      @default(0)
  allowances   Float      @default(0)
  overtime     Float      @default(0)
  bonuses      Float      @default(0)
  insurance    Float      @default(0)
  tax          Float      @default(0)
  otherDeductions Float   @default(0)
  net          Float      @default(0)
  notes        String?

  @@unique([payrollRunId, employeeId])
}

// ===== الموازنات =====

model Budget {
  id         String   @id @default(cuid())
  name       String
  fiscalYear Int
  type       String   @default("EXPENSE") // REVENUE | EXPENSE
  status     String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines BudgetLine[]

  @@index([fiscalYear, type])
}

model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryName  String
  periodMonth   Int?
  amount        Float    @default(0)
  actualAmount  Float    @default(0)
  notes         String?

  @@index([budgetId])
}

// ===== إعدادات عامة مرنة =====

model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}
