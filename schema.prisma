generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  name            String   @default("شركة دفاتر المحاسب")
  nameEn          String?
  taxNumber       String?
  commercialReg   String?
  address         String?
  city            String?
  phone           String?
  email           String?
  website         String?
  logo            String?
  currency        String   @default("EGP")
  fiscalYearStart Int      @default(1)
  vatRate         Float    @default(14)
  whtRate         Float    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  name               String
  email              String?
  phone              String?
  role               String   @default("accountant")
  accessAllCompanies Boolean  @default(true)
  isActive           Boolean  @default(true)
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  portalLoginLogs    PortalLoginLog[]
  assignedTasks      OfficeTask[] @relation("TaskAssignee")
  engagements        EngagementMember[]
  timeEntries        TimeEntry[]
  notifications      Notification[]
}

model ClientCompany {
  id                  String   @id @default(cuid())
  code                String   @unique
  nameAr              String
  nameEn              String?
  legalForm           String   @default("INDIVIDUAL")
  entityType          String   @default("COMPANY")
  activity            String?
  taxNumber           String?
  taxFileNumber       String?
  taxOffice           String?
  vatRegistrationNumber String?
  vatRegistrationDate   DateTime?
  vatOffice           String?
  commercialRegNumber String?
  socialInsuranceNumber String?
  electronicInvoiceId String?
  electronicInvoiceKey String?
  eSignatureSerial    String?
  eSignatureExpiryDate DateTime?
  phone               String?
  email               String?
  address             String?
  city                String?
  ownerName           String?
  ownerNationalId     String?
  ownerPhone          String?
  contactPerson       String?
  contactPhone        String?
  notes               String?
  isActive            Boolean  @default(true)
  kind                String   @default("CLIENT") // OFFICE دفاتر المكتب | CLIENT شركة عميل
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  obligations         TaxObligation[]
  tasks               OfficeTask[]
  documents           ArchivedDocument[]
  platformCredentials PlatformCredential[]
  portalLoginLogs     PortalLoginLog[]
  invoices            Invoice[]
  purchases           Purchase[]
  engagements         Engagement[]
  dmsDocuments        DmsDocument[]

  // ===== دفاتر الشركة (النطاق المحاسبي) =====
  journalEntries JournalEntry[]
  bankTransactions BankTransaction[]
  monthCloses      MonthClose[]
  recurringInvoices RecurringInvoice[]
  safes          Safe[]
  parties        Party[]
  products       Product[]
  stockMovements StockMovement[]
  fixedAssets    FixedAsset[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
  budgets        Budget[]
  payments       Payment[]
}

model TaxObligation {
  id            String   @id @default(cuid())
  companyId     String
  company       ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String
  title         String
  period        String
  periodYear    Int
  periodMonth   Int?
  periodQuarter Int?
  dueDate       DateTime
  amountDue     Float?
  amountPaid    Float?
  status        String   @default("PENDING")
  referenceNumber String?
  notes         String?
  fulfilledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasks         OfficeTask[]
}

model OfficeTask {
  id            String   @id @default(cuid())
  taskNumber    String   @unique
  title         String
  description   String?
  companyId     String?
  company       ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  obligationId  String?
  obligation    TaxObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  assignedTo    String?
  assignedToUser User?   @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  priority      String   @default("MEDIUM")
  status        String   @default("TODO")
  category      String   @default("GENERAL")
  dueDate       DateTime?
  completedAt   DateTime?
  notes         String?

  // مصدر المهمة: ملف العمل والقالب الذي أنشأها — يجعل إعادة توليد القوائم آمنة
  // ويجيب سؤال «لماذا وُجدت هذه المهمة؟» في أي مراجعة
  engagementId  String?
  engagement    Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  templateCode  String?
  autoGenerated Boolean  @default(false)

  timeEntries   TimeEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ArchivedDocument {
  id          String   @id @default(cuid())
  companyId   String
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String   @default("OTHER")
  title       String
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  issuedAt    DateTime?
  expiresAt   DateTime?
  tags        String?
  notes       String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformCredential {
  id          String   @id @default(cuid())
  companyId   String
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform    String
  label       String
  loginUrl    String
  username    String?
  password    String?
  extraField  String?
  notes       String?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  lastLoginStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loginLogs   PortalLoginLog[]

  @@unique([companyId, platform])
}

model PortalLoginLog {
  id           String   @id @default(cuid())
  credentialId String
  credential   PlatformCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  companyId    String
  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String
  httpStatus   Int?
  message      String
  durationMs   Int
  createdAt    DateTime @default(now())
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  parentId  String?
  parent    Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children  Account[] @relation("AccountTree")
  isGroup   Boolean  @default(false)
  level     Int      @default(1)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines        JournalLine[]
  safes               Safe[]
  fixedAssets         FixedAsset[]
  depreciationAssets  FixedAsset[] @relation("AssetDepreciationAccount")
  budgetLines         BudgetLine[]
}

model Invoice {
  id            String   @id @default(cuid())
  companyId     String?
  company       ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoiceNumber String   @unique
  date          DateTime
  totalAmount   Float
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ===== حقول الشق المالي (مضافة) =====
  customerId    String?
  customer      Party?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  subtotal      Float      @default(0)
  discount      Float      @default(0)
  taxRate       Float      @default(0)
  taxAmount     Float      @default(0)
  paidAmount    Float      @default(0)
  costAmount    Float      @default(0)
  notes         String?
  createdBy     String     @default("system")
  journalPosted Boolean    @default(false)
  sourceDocumentId String? // الوثيقة الأصلية في DMS التي استُخرِجت منها
  sourceDocument DmsDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  // ===== الفوترة الإلكترونية — هيئة الضرائب المصرية (ETA) =====
  etaStatus      String?  // PENDING | SUBMITTED | ACCEPTED | REJECTED | FAILED
  etaDocUuid     String?  // الرقم المرجعي الذي تسنده الهيئة للمستند
  etaSubmission  String?  // رقم دفعة الإرسال (submissionUUID)
  etaStatusAt    DateTime?
  etaError       String?  // سبب الرفض/الفشل من الهيئة

  recurringId String?
  recurring   RecurringInvoice? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  items InvoiceItem[]

  @@index([status])
  @@index([date])
  @@index([customerId])
  @@index([etaStatus])
  @@index([recurringId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  lineNet     Float    @default(0)
  lineTax     Float    @default(0)
  lineTotal   Float    @default(0)
  costPrice   Float    @default(0)
  accountId   String? // حساب الإيراد المخصص لهذا السطر
  sortOrder   Int      @default(0)

  @@index([invoiceId])
  @@index([productId])
}

model Purchase {
  id             String   @id @default(cuid())
  companyId      String?
  company        ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  purchaseNumber String   @unique
  date           DateTime
  totalAmount    Float
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ===== حقول الشق المالي (مضافة) =====
  supplierId   String?
  supplier     Party?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  subtotal     Float      @default(0)
  discount     Float      @default(0)
  taxRate      Float      @default(0)
  taxAmount    Float      @default(0)
  paidAmount   Float      @default(0)
  notes        String?
  createdBy    String     @default("system")
  journalPosted Boolean   @default(false)
  sourceDocumentId String? // الوثيقة الأصلية في DMS التي استُخرِجت منها
  sourceDocument DmsDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  items PurchaseItem[]

  @@index([status])
  @@index([date])
  @@index([supplierId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  lineNet     Float    @default(0)
  lineTax     Float    @default(0)
  lineTotal   Float    @default(0)
  accountId   String? // حساب المصروف المخصص لهذا السطر
  sortOrder   Int      @default(0)

  @@index([purchaseId])
  @@index([productId])
}

model DocumentSequence {
  id         String   @id @default(cuid())
  type       String   @unique
  prefix     String
  nextNumber Int      @default(1)
  padding    Int      @default(5)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  username  String   @default("system")
  createdAt DateTime @default(now())
}

// ============================================================================
// الشق المالي والمحاسبي — نماذج مضافة
// كل ما سبق أعلاه هو أساس شق المكتب ويبقى كما هو بدون أي تعديل على الحقول.
// ============================================================================

// ===== أطراف الحساب: عملاء وموردون =====

model Party {
  id             String   @id @default(cuid())
  code           String   @unique
  companyId      String?
  company        ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name           String
  type           String   @default("CUSTOMER") // CUSTOMER | SUPPLIER
  legalName      String?
  taxNumber      String?
  commercialReg  String?
  phone          String?
  email          String?
  address        String?
  city           String?
  openingBalance Float    @default(0)
  balanceSide    String   @default("DEBIT") // nature مدين أو دائن للرصيد الافتتاحي
  creditLimit    Float?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices  Invoice[]
  purchases Purchase[]
  payments  Payment[]
  recurringInvoices RecurringInvoice[]

  @@index([type, isActive])
  @@index([name])
  @@index([companyId])
}

model Safe {
  id             String   @id @default(cuid())
  code           String   @unique
  companyId      String?
  company        ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name           String
  type           String   @default("CASH") // CASH خزينة | BANK حساب بنكي
  accountId      String? // الحساب المقابل في دليل الحسابات
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  openingBalance Float    @default(0)
  bankName       String?
  accountNumber  String?
  iban           String?
  branch         String?
  currency       String   @default("EGP")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]
  bankTransactions BankTransaction[]

  @@index([type, isActive])
  @@index([companyId])
}

model Payment {
  id        String   @id @default(cuid())
  number    String   @unique
  companyId String?
  company   ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type      String // IN تحصيل | OUT صرف
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  safeId    String?
  safe      Safe?    @relation(fields: [safeId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  amount    Float
  method    String   @default("CASH") // CASH | BANK | CHEQUE | TRANSFER
  reference String?
  sourceType String? // INVOICE | PURCHASE | OTHER
  sourceId   String?
  sourceDocumentId String? // الوثيقة الأصلية في DMS التي استُخرِجت منها
  sourceDocument DmsDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  notes      String?
  createdBy  String   @default("system")
  createdAt  DateTime @default(now())

  @@index([companyId])
  updatedAt  DateTime @updatedAt

  bankTransactions BankTransaction[]

  @@index([type, date])
  @@index([partyId])
  @@index([sourceType, sourceId])
}

// ===== القيود اليومية ودليل الحسابات =====

model JournalEntry {
  id          String    @id @default(cuid())
  number      String    @unique
  date        DateTime
  description String
  sourceType  String? // INVOICE | PURCHASE | PAYMENT | ASSET_DEPRECIATION | OPENING | MANUAL
  sourceId    String?
  companyId   String?
  company     ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      String    @default("POSTED") // DRAFT | POSTED | REVERSED
  totalDebit  Float     @default(0)
  totalCredit Float     @default(0)
  postedAt    DateTime?
  reversedById String?
  notes       String?
  createdBy   String    @default("system")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines JournalLine[]

  @@index([date])
  @@index([status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  partyId        String?
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  costCenter     String?
  sortOrder      Int          @default(0)

  @@index([accountId])
  @@index([journalEntryId])
}

// ===== المخزون =====

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  companyId   String?
  company     ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  category    String?
  unit        String   @default("قطعة")
  quantity    Float    @default(0)
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  minStock    Float    @default(0)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  movements      StockMovement[]

  @@index([name])
  @@index([isActive])
  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String?
  company   ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type      String // IN مشتريات | OUT مبيعات | ADJUST تسوية | OPENING رصيد افتتاحي | RETURN_IN عكس مبيعات | RETURN_OUT عكس مشتريات
  quantity  Float
  unitCost  Float    @default(0)
  date      DateTime @default(now())
  safeId    String?
  sourceType String?
  sourceId   String?
  notes     String?
  createdBy String   @default("system")
  createdAt DateTime @default(now())

  @@index([productId, date])
  @@index([type])
  @@index([companyId])
}

// ===== الأصول الثابتة والإهلاك =====

model FixedAsset {
  id            String   @id @default(cuid())
  code          String   @unique
  companyId     String?
  company       ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name          String
  category      String?
  acquisitionDate DateTime
  cost          Float
  salvageValue  Float    @default(0)
  lifeYears     Float    @default(5)
  method        String   @default("STRAIGHT_LINE") // STRAIGHT_LINE | DECLINING
  salvageRate   Float    @default(0)
  accumulatedDepreciation Float @default(0)
  accountId     String? // حساب الأصل في دليل الحسابات
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  depreciationAccountId String? // حساب مصروف الإهلاك
  depreciationAccount Account? @relation("AssetDepreciationAccount", fields: [depreciationAccountId], references: [id], onDelete: SetNull)
  status        String   @default("ACTIVE") // ACTIVE | DISPOSED
  acquisitionPosted Boolean @default(false) // قيد الاستحواذ مرحّل إلى اليومية
  disposalDate     DateTime?
  disposalProceeds Float? // قيمة البيع عند الصرف
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt

  depreciations DepreciationEntry[]

  @@index([status])
  @@index([companyId])
}

model DepreciationEntry {
  id         String     @id @default(cuid())
  assetId    String
  asset      FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodYear Int
  periodMonth Int?
  amount     Float
  accumAfter Float      @default(0)
  date       DateTime
  journalEntryId String?
  notes      String?
  createdAt  DateTime   @default(now())

  @@unique([assetId, periodYear, periodMonth])
  @@index([periodYear])
}

// ===== الموظفون والرواتب =====

model Employee {
  id              String   @id @default(cuid())
  code            String   @unique
  companyId       String?
  company         ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name            String
  jobTitle        String?
  department      String?
  nationalId      String?
  phone           String?
  email           String?
  hireDate        DateTime @default(now())
  basicSalary     Float    @default(0)
  housingAllowance Float   @default(0)
  transportAllowance Float @default(0)
  otherAllowance   Float    @default(0)
  insuranceNumber String?
  bankName        String?
  bankAccount     String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payslips Payslip[]

  @@index([isActive])
  @@index([companyId])
}

model PayrollRun {
  id          String   @id @default(cuid())
  companyId   String?
  company     ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  periodYear  Int
  periodMonth Int
  status      String   @default("DRAFT") // DRAFT | APPROVED | POSTED
  totalGross  Float    @default(0)
  totalDeductions Float @default(0)
  totalNet    Float    @default(0)
  journalEntryId String?
  paidAt         DateTime? // وقت صرف الصافي من الخزينة/البنك
  notes       String?
  createdBy   String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId])
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic        Float      @default(0)
  allowances   Float      @default(0)
  overtime     Float      @default(0)
  bonuses      Float      @default(0)
  insurance    Float      @default(0)
  employerInsurance Float @default(0) // مساهمة صاحب العمل (لبيان التأمينات)
  tax          Float      @default(0)
  otherDeductions Float   @default(0)
  net          Float      @default(0)
  notes        String?

  @@unique([payrollRunId, employeeId])
}

// ===== الموازنات =====

model Budget {
  id         String   @id @default(cuid())
  name       String
  companyId  String?
  company    ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fiscalYear Int
  type       String   @default("EXPENSE") // REVENUE | EXPENSE
  status     String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines BudgetLine[]

  @@index([fiscalYear, type])
  @@index([companyId])
}

model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryName  String
  periodMonth   Int?
  amount        Float    @default(0)
  actualAmount  Float    @default(0)
  notes         String?

  @@index([budgetId])
}

// ===== إعدادات عامة مرنة =====

model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}

// ============================================================================
// spine الاستقلالية: سجل الأحداث، محرك الأتمتة، وإدارة المكتب
// ---------------------------------------------------------------------------
// القاعدة: كل تغيير في النظام يُسجَّل في EventLog بسلسلة تجزئة (hash chain)،
// فلا يمكن تعديل أو حذف أي حدث دون كسر السلسلة detectable.
// ============================================================================

// ===== سجل الأحداث: مصدر الحقيقة الوحيد =====

model EventLog {
  id        String   @id @default(cuid())
  seq       Int      @default(0) // يتسلسل يدويًا في transaction (SQLite لا يدعم autoincrement خارج id)
  at        DateTime @default(now())
  actor     String   @default("system")
  actorType String   @default("system") // human | automation | system
  action    String
  entity    String
  entityId  String   @default("")
  summary   String
  payload   String? // JSON
  ip        String?
  prevHash  String   @default("")
  hash      String

  jobs Job[]

  @@index([at])
  @@index([entity, entityId])
  @@index([action])
  @@index([actorType])
}

// ===== الأتمتة: القواعد والطابور =====

model AutomationRule {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  trigger     String    @default("EVENT") // EVENT | SCHEDULE
  eventType   String? // مثال: obligation.created
  cron        String?
  enqueueJob  String? // نوع المهمة التي تُنشأ
  action      String? // كود المعالج عند التشغيل المباشر
  params      String? // JSON
  enabled     Boolean   @default(true)
  priority    Int       @default(100)
  lastRunAt   DateTime?
  lastError   String?
  runCount    Int       @default(0)
  errorCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled, trigger])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        String    @default("{}")
  status         String    @default("PENDING") // PENDING RUNNING DONE FAILED DEAD
  priority       Int       @default(100)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String?   @unique
  sourceEventId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  durationMs     Int?

  sourceEvent EventLog? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  runs        JobRun[]

  @@index([status, runAt])
  @@index([type, status])
  @@index([sourceEventId])
}

model JobRun {
  id        String    @id @default(cuid())
  jobId     String
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt   Int       @default(1)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  ok        Boolean?
  error     String?
  result    String?

  @@index([jobId])
}

// ===== إدارة المكتب:Engagements =====

model ServiceType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("ACCOUNTING") // TAX | ACCOUNTING | AUDIT | ADVISORY | PAYROLL
  defaultFee  Float    @default(0)
  billingType String   @default("FIXED") // FIXED | HOURLY | PER_UNIT
  slaDays     Int      @default(7)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  engagements Engagement[]
}

model Engagement {
  id          String    @id @default(cuid())
  code        String    @unique
  clientId    String
  client      ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId   String
  service     ServiceType   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  periodYear  Int
  periodMonth Int?
  title       String
  status      String    @default("ACTIVE") // PLANNING | ACTIVE | ON_HOLD | CLOSED
  feeAmount   Float     @default(0)
  currency    String    @default("EGP")
  startDate   DateTime?
  dueDate     DateTime?
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   EngagementMember[]
  tasks     OfficeTask[]
  times     TimeEntry[]
  documents DmsDocument[]

  @@unique([clientId, serviceId, periodYear, periodMonth])
  @@index([status, dueDate])
  @@index([clientId])
}

model EngagementMember {
  id            String     @id @default(cuid())
  engagementId  String
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String     @default("MEMBER") // LEAD | REVIEWER | MEMBER
  allocationPct Float      @default(0)
  createdAt     DateTime   @default(now())

  @@unique([engagementId, userId])
  @@index([userId])
}

model TaskTemplate {
  id               String   @id @default(cuid())
  code             String   @unique
  title            String
  description      String?
  category         String   @default("GENERAL")
  priority         String   @default("MEDIUM")
  offsetDays       Int      @default(0) // إزاحة بالأيام من بداية الفترة
  serviceCode      String? // الخدمة التي ينطبق عليها
  estimatedMinutes Int      @default(60)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== إدارة الوثائق (DMS) والاستخراج بالذكاء الاصطناعي =====

model DmsDocument {
  id           String   @id @default(cuid())
  clientId     String?
  client       ClientCompany? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  type         String   @default("OTHER") // INVOICE | RECEIPT | BANK_STATEMENT | CONTRACT | ID | TAX_FORM | OTHER
  title        String
  status       String   @default("UPLOADED") // UPLOADED | EXTRACTING | REVIEW | APPROVED | REJECTED
  storagePath  String
  mimeType     String
  size         Int
  pageCount    Int?
  checksum     String   @unique
  source       String   @default("upload") // upload | scan | email | api
  uploadedBy   String?
  periodYear   Int?
  periodMonth  Int?
  tags         String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions   DmsDocumentVersion[]
  extractions Extraction[]
  timeEntries TimeEntry[]
  invoices  Invoice[]
  purchases Purchase[]
  payments  Payment[]

  @@index([clientId])
  @@index([type, status])
  @@index([createdAt])
}

model DmsDocumentVersion {
  id          String      @id @default(cuid())
  documentId  String
  document    DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  storagePath String
  checksum    String
  note        String?
  createdBy   String?
  createdAt   DateTime    @default(now())

  @@unique([documentId, version])
}

model Extraction {
  id         String      @id @default(cuid())
  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider   String      @default("manual")
  model      String?
  status     String      @default("PENDING") // PENDING | DONE | FAILED
  confidence Float       @default(0)
  fields     String      @default("[]") // JSON: [{key,label,value,confidence,page,raw}]
  rawText    String?
  durationMs Int?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([documentId])
  @@index([status])
}

// ===== إشعارات والتنبيهات =====

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String? // عند الاستهداف لدور كامل بدل مستخدم بعينه
  kind      String    @default("INFO") // SLA_BREACH | APPROVAL_REQUIRED | JOB_FAILED | DEADLINE | INFO
  severity  String    @default("info") // info | warning | critical
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([kind, severity])
}

// ===== تسجيل الوقت وقياس الإنتاجية =====
model TimeEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String?
  task         OfficeTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  documentId   String?
  document     DmsDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  minutes      Int      @default(0)
  date         DateTime @default(now())
  billable     Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@index([engagementId])
}

// ===== مطابقة البنك =====
// سطور كشف البنك (تُدخل يدويًا أو تستورد) تُطابَق مع سندات القبض/الصرف
// على نفس الخزينة البنكية.

model BankTransaction {
  id             String    @id @default(cuid())
  companyId      String
  company        ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  safeId         String
  safe           Safe      @relation(fields: [safeId], references: [id], onDelete: Cascade)
  date           DateTime
  reference      String? // رقم العملية في كشف البنك
  description    String?
  amount         Float
  direction      String    @default("IN") // IN إيداع | OUT سحب
  status         String    @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED
  matchedPaymentId String?
  matchedPayment Payment?  @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([safeId, date])
  @@index([companyId])
  @@index([status])
}

// ===== إغلاق الشهر =====
// سجل إغلاق فترة شهرية: لقطة الفحوصات لحظة الإغلاق. إغلاق الفترة يمنع
// أي قيد بتاريخ داخلها (يُعاد الفتح من نفس الشاشة).

model MonthClose {
  id        String   @id @default(cuid())
  companyId String
  company   ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  closedAt  DateTime @default(now())
  closedBy  String
  checks    String   // JSON — لقطة نتائج الفحوصات لحظة الإغلاق

  @@unique([companyId, year, month])
  @@index([companyId])
}

// ===== الفواتير المتكررة =====
// نموذج فاتورة دورية (إيجار، اشتراك، أتعاب ثابتة...) يولّد مسودة فاتورة
// تلقائيًا عند كل استحقاق ويُقدَّم موعده التالي.

model RecurringInvoice {
  id          String   @id @default(cuid())
  companyId   String?
  company     ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String // تسمية داخلية: إيجار المكتب، اشتراك شهري...
  customerId  String?
  customer    Party?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount      Float // إجمالي الفاتورة المتولد
  frequency   String   @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUALLY
  notes       String?
  active      Boolean  @default(true)
  nextDueDate DateTime // الاستحقاق التالي
  lastGeneratedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generatedInvoices Invoice[]

  @@index([companyId, active])
  @@index([nextDueDate])
}
