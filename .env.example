# ===== دفاتر المحاسب — إعدادات البيئة =====
# انسخ هذا الملف إلى .env ثم عدّل القيم

# قاعدة البيانات المحلية (SQLite)
# ملاحظة: Prisma يحل المسار النسبي بالنسبة لمجلد prisma/ وليس لجذر المشروع،
# لذلك ../db/app.db ينتج الملف في db/app.db على جذر المشروع (وهو ما تستثنيه .gitignore)
DATABASE_URL="file:../db/app.db"

# سر توقيع كوكي الجلسة (HMAC-SHA256).
# مهم: غيّره في أي استخدام حقيقي — القيمة الاحتياطية أدناه معرفة ومكتوبة في الكود.
SESSION_SECRET="change-me-to-a-long-random-string"

# كلمة المرور الافتراضية لمدير النظام الذي ينشئه `npm run db:init`
ADMIN_PASSWORD="admin123"
ADMIN_USERNAME="admin"
